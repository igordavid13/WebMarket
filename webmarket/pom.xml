<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/>
	</parent>
	
	<groupId>br.gov.caixa</groupId>
	<artifactId>webmarket</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>WebMarket</name>		
	<description>Projeto final do módulo Arquitetura de Software Ágil II</description>
	
	<developers>
		<developer>
			<id>Davi</id>
			<name>Davi</name>
		</developer>
		<developer>
			<id>Marcos</id>
			<name>Marcos</name>
		</developer>
		<developer>
			<id>Yuri</id>
			<name>Yuri</name>
		</developer>
	</developers>
	
	<modules>
		<module>shared-contracts</module>
		<module>ms-pedido</module>
		<module>ms-produto</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <resilience4j.version>2.2.0</resilience4j.version>
        <pact.version>4.6.14</pact.version>
        <qpid.version>9.2.0</qpid.version>
        <embedded-redis.version>1.4.3</embedded-redis.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>br.gov.caixa.webmarket.contracts</groupId>
				<artifactId>shared-contracts</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>plano-b-jvm</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<dependencies>
				<!-- Cache: Caffeine atrás da abstração Spring Cache (substitui Redis) -->
				<dependency>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-cache</artifactId>
				</dependency>
				<dependency>
					<groupId>com.github.ben-manes.caffeine</groupId>
					<artifactId>caffeine</artifactId>
				</dependency>
				<!-- Filas: Spring AMQP -->
				<dependency>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-amqp</artifactId>
				</dependency>
				<!-- Tópicos: broker Kafka in-JVM (substitui Kafka via Docker) -->
				<dependency>
					<groupId>org.springframework.kafka</groupId>
					<artifactId>spring-kafka</artifactId>
				</dependency>
				<dependency>
					<groupId>org.springframework.kafka</groupId>
					<artifactId>spring-kafka-test</artifactId>
				</dependency>
			</dependencies>
		</profile>
	</profiles>

</project>

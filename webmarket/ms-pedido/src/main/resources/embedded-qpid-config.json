{
  "name": "webmarket",
  "modelVersion": "8.0",
  "authenticationproviders": [
    {
      "name": "plain",
      "type": "Plain",
      "users": [
        {
          "name": "guest",
          "type": "managed",
          "password": "guest"
        }
      ],
      "secureOnlyMechanisms": []
    }
  ],
  "ports": [
    {
      "name": "AMQP",
      "port": "${qpid.amqp_port}",
      "authenticationProvider": "plain",
      "authenticationMechanisms": [
        "PLAIN"
      ],
      "virtualhostaliases": [
        {
          "name": "default",
          "type": "nameAlias",
          "virtualHostNode": "default"
        },
        { "name": "defaultAlias", "type": "defaultAlias" },
        { "name": "hostnameAlias", "type": "hostnameAlias" }
      ]
    }
  ],
  "virtualhostnodes": [
    {
      "name": "default",
      "type": "Memory",
      "defaultVirtualHostNode": "true"
    }
  ]
}
